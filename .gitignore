# ==========================================
# 1. Operating System (OS) Cleanups
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ==========================================
# 2. IDE & Editor Artifacts
# ==========================================
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/
.idea_modules/

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# ==========================================
# 3. Java & Gradle (Spring Boot Backend)
# ==========================================
# Compiled class file
*.class

# Log files
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Gradle directory and build outputs
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Spring Boot Configuration Secret Overrides (Local Secrets)
application-local.yml
application-secret.yml
application-dev.yml

# ==========================================
# 4. Node.js & React (Frontend)
# ==========================================
# Dependency directories
frontend/node_modules/
node_modules/

# Production build outputs
frontend/dist/
frontend/build/

# Spring Boot static folder generated by React build
# (Vite/React 빌드 결과물이 자동 생성되는 위치이므로 Git 추적 제외)
src/main/resources/static/*
!src/main/resources/static/.gitkeep

# Environment variables & Local config
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env
frontend/.env.local

# npm / yarn / pnpm logs & debug outputs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite cache
frontend/.vite/

# ==========================================
# 5. Database & Temp Files
# ==========================================
*.sql
*.sqlite
*.db

# Temp files
*.tmp
*.bak
*.swp